diff --git a/src/mame.c b/src/mame.c
index 6daf751..8906392 100644
--- a/src/mame.c
+++ b/src/mame.c
@@ -665,6 +665,202 @@ static int vh_open(void)
 
 int need_to_clear_bitmap;	/* set by the user interface */
 
+/***************************************************************************
+
+  Drawing on another core. A driver that can draw a frame from a copy of
+  its video state (cps1) asks for it in vh_start. Then at every vblank the
+  game thread waits for the previous frame's drawing to finish, shows it,
+  copies the video state for this frame and lets the worker draw that into
+  the other bitmap while the cpus run the next frame. The screen is one
+  frame behind the emulation, the emulation itself never changes: drawing
+  only reads the copy and writes its own bitmap/palette/caches, and the
+  game thread only touches those while the worker is idle.
+
+***************************************************************************/
+
+#if defined(VITA)
+#include <psp2/kernel/threadmgr.h>
+#include <psp2/kernel/cpu.h>
+
+typedef SceUID render_sema;
+static int render_sema_init(render_sema *s, const char *name) { *s = sceKernelCreateSema(name, 0, 0, 0x7FFFFFFF, NULL); return *s >= 0; }
+static void render_sema_free(render_sema *s) { sceKernelDeleteSema(*s); }
+static void render_sema_post(render_sema *s) { sceKernelSignalSema(*s, 1); }
+static void render_sema_wait(render_sema *s) { sceKernelWaitSema(*s, 1, NULL); }
+static SceUID render_thread_id = -1;
+#else
+#include <pthread.h>
+#include <semaphore.h>
+
+typedef sem_t render_sema;
+static int render_sema_init(render_sema *s, const char *name) { (void)name; return sem_init(s, 0, 0) == 0; }
+static void render_sema_free(render_sema *s) { sem_destroy(s); }
+static void render_sema_post(render_sema *s) { sem_post(s); }
+static void render_sema_wait(render_sema *s) { while (sem_wait(s) != 0) { } }
+static pthread_t render_pthread;
+#endif
+
+static void (*render_snapshot)(void);
+static int render_on;
+static struct osd_bitmap *render_bitmap[2];	/* [0] is the one vh_open made */
+static int render_back;						/* the one the worker draws into */
+static struct osd_bitmap *render_target;
+static int render_full;
+static volatile int render_quit;
+static volatile unsigned render_posted, render_handled;
+static render_sema render_work, render_done;
+
+void mame_render_thread_request(void (*snapshot)(void))
+{
+	render_snapshot = snapshot;
+}
+
+static void render_worker(void)
+{
+	for (;;)
+	{
+		render_sema_wait(&render_work);
+		if (__atomic_load_n(&render_quit, __ATOMIC_ACQUIRE))
+			break;
+
+		(void)__atomic_load_n(&render_posted, __ATOMIC_ACQUIRE);
+		(*Machine->drv->vh_update)(render_target, render_full);
+
+		__atomic_store_n(&render_handled, render_handled + 1, __ATOMIC_RELEASE);
+		render_sema_post(&render_done);
+	}
+}
+
+#if defined(VITA)
+static int render_entry(SceSize args, void *argp) { (void)args; (void)argp; render_worker(); return 0; }
+#else
+static void *render_entry(void *arg) { (void)arg; render_worker(); return NULL; }
+#endif
+
+static void render_wait(void)
+{
+	while (__atomic_load_n(&render_handled, __ATOMIC_ACQUIRE) != render_posted)
+		render_sema_wait(&render_done);
+}
+
+static void render_thread_start(void)
+{
+	struct osd_bitmap *front = Machine->scrbitmap;
+
+	render_on = 0;
+	if (!render_snapshot || artwork_overlay || !front)
+		return;
+#if !defined(VITA)
+	if (getenv("MAME_RENDER_THREAD") && !strcmp(getenv("MAME_RENDER_THREAD"), "0"))
+		return;
+#endif
+
+	render_bitmap[0] = front;
+	render_bitmap[1] = osd_alloc_bitmap(front->width, front->height, front->depth);
+	if (!render_bitmap[1])
+		return;
+	osd_clearbitmap(render_bitmap[1]);
+
+	render_quit = 0;
+	render_posted = render_handled = 0;
+	if (!render_sema_init(&render_work, "mame_render_work"))
+		goto fail_bitmap;
+	if (!render_sema_init(&render_done, "mame_render_done"))
+		goto fail_work;
+
+#if defined(VITA)
+	/* user core 1, the game keeps core 0 */
+	render_thread_id = sceKernelCreateThread("mame_render", render_entry, 0x10000100, 0x40000, 0,
+			SCE_KERNEL_CPU_MASK_USER_1, NULL);
+	if (render_thread_id >= 0 && sceKernelStartThread(render_thread_id, 0, NULL) < 0)
+	{
+		sceKernelDeleteThread(render_thread_id);
+		render_thread_id = -1;
+	}
+	if (render_thread_id < 0)
+		goto fail_done;
+#else
+	if (pthread_create(&render_pthread, NULL, render_entry, NULL) != 0)
+		goto fail_done;
+#endif
+
+	/* the worker draws into [1] first, [0] (blank) is on screen meanwhile */
+	render_back = 1;
+	render_on = 1;
+	return;
+
+fail_done:
+	render_sema_free(&render_done);
+fail_work:
+	render_sema_free(&render_work);
+fail_bitmap:
+	osd_free_bitmap(render_bitmap[1]);
+	render_bitmap[1] = NULL;
+}
+
+static void render_thread_stop(void)
+{
+	if (!render_on)
+		return;
+
+	render_wait();
+	__atomic_store_n(&render_quit, 1, __ATOMIC_RELEASE);
+	render_sema_post(&render_work);
+#if defined(VITA)
+	sceKernelWaitThreadEnd(render_thread_id, NULL, NULL);
+	sceKernelDeleteThread(render_thread_id);
+	render_thread_id = -1;
+#else
+	pthread_join(render_pthread, NULL);
+#endif
+	render_sema_free(&render_work);
+	render_sema_free(&render_done);
+
+	/* vh_close frees whatever Machine->scrbitmap is, give it its own back */
+	Machine->scrbitmap = render_bitmap[0];
+	real_scrbitmap = render_bitmap[0];
+	osd_free_bitmap(render_bitmap[1]);
+	render_bitmap[1] = NULL;
+	render_on = 0;
+}
+
+static int updatescreen_threaded(void)
+{
+	/* last frame's drawing is done: that's what goes on screen now */
+	render_wait();
+	Machine->scrbitmap = real_scrbitmap = render_bitmap[render_back];
+	render_back ^= 1;
+
+	if (handle_user_interface(real_scrbitmap))
+		return 1;
+
+	update_video_and_audio();
+
+	/* this frame's video state, taken before the eof callback buffers the
+	   sprites for the next one, same order as drawing it right here */
+	(*render_snapshot)();
+	if (bitmap_dirty)
+		overlay_remap();
+
+	if (drv->vh_eof_callback) (*drv->vh_eof_callback)();
+
+	render_target = render_bitmap[render_back];
+
+	/* osd_clearbitmap() marks bitmap_dirty, so it happens here, not on the
+	   worker */
+	if (need_to_clear_bitmap)
+	{
+		osd_clearbitmap(render_target);
+		need_to_clear_bitmap = 0;
+	}
+	render_full = bitmap_dirty;
+	bitmap_dirty = 0;
+
+	__atomic_store_n(&render_posted, render_posted + 1, __ATOMIC_RELEASE);
+	render_sema_post(&render_work);
+	return 0;
+}
+
 int updatescreen(void)
 {
 	/* Substitute silence for sound_update() while the game is paused:
@@ -678,6 +874,9 @@ int updatescreen(void)
 	else
 		sound_update();
 
+	if (render_on)
+		return updatescreen_threaded();
+
 	if (osd_skip_this_frame() == 0)
 	{
 		profiler_mark(PROFILER_VIDEO);
@@ -794,6 +993,7 @@ static int run_machine_init(void)
 	rm_state = 3;
 
 	real_scrbitmap = artwork_overlay ? overlay_real_scrbitmap : Machine->scrbitmap;
+	render_thread_start();
 
 	/* free memory regions allocated with REGIONFLAG_DISPOSE (typically gfx roms) */
 	{
@@ -868,6 +1068,8 @@ static void run_machine_exit(void)
 		/* save input ports settings */
 		save_input_port_settings();
 	}
+	render_thread_stop();
+	render_snapshot = NULL;
 	if (rm_state >= 3) sound_stop();
 	if (rm_state >= 2 && drv->vh_stop) (*drv->vh_stop)();
 	if (rm_state >= 1)
