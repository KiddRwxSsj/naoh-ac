diff --git a/svn-current/trunk/src/cpu/m68000_intf.cpp b/svn-current/trunk/src/cpu/m68000_intf.cpp
index cc542ca..d60fc5c 100644
--- a/svn-current/trunk/src/cpu/m68000_intf.cpp
+++ b/svn-current/trunk/src/cpu/m68000_intf.cpp
@@ -1143,6 +1143,20 @@ void SekReset()
 #endif
 
 #ifdef EMU_M68K
+		// musashi's reset only loads sp, pc and sr. the general registers,
+		// the banked stack pointers and the prefetch/ir leftovers all keep
+		// whatever the last game running on this core left behind, so two
+		// boots of the same rom stopped matching. zero them instead
+		static const m68k_register_t stale[] = {
+			M68K_REG_USP, M68K_REG_ISP, M68K_REG_MSP,
+			M68K_REG_PREF_ADDR, M68K_REG_PREF_DATA, M68K_REG_PPC, M68K_REG_IR
+		};
+		for (INT32 r = M68K_REG_D0; r <= M68K_REG_A6; r++) {
+			m68k_set_reg((m68k_register_t)r, 0);
+		}
+		for (UINT32 i = 0; i < sizeof(stale) / sizeof(stale[0]); i++) {
+			m68k_set_reg(stale[i], 0);
+		}
 		m68k_pulse_reset();
 #endif
 
